# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Datos locales de preprocesamiento (OSM .pbf, grafos .roadgraph, teselas)
# -- son insumos/salidas de tools/, no código; algunos pasan los 100 MB.
# Anclado a la raíz: NO debe afectar a lib/features/*/data/ (eso sí es código).
/data/

# Volcado local del árbol de directorios (generado, no es código)
arbol.txt

# Los paquetes internos (packages/*) son librerías, no apps: por convención
# Dart no se versiona su pubspec.lock (solo el de la app raíz).
packages/*/pubspec.lock
